# ============================================================
#  AI ASSISTANT — ENVIRONMENT CONFIGURATION
# ============================================================

# --- Telegram ---
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Your personal numerical chat ID (obtain by messaging @userinfobot)
TELEGRAM_CHAT_ID=123456789

# Public HTTPS URL of your deployment (leave blank for local polling mode)
TELEGRAM_WEBHOOK_URL=

# --- Google OAuth ---
GOOGLE_CREDENTIALS_PATH=credentials/credentials.json
GOOGLE_TOKEN_PATH=credentials/token.json

# Optional: base64 encoded token.json or credentials.json for cloud deployment
GOOGLE_CREDENTIALS_B64=
GOOGLE_TOKEN_B64=

# --- AI Engines (Lightweight Multi-Provider Fallback Cascade) ---
# All models are fast 7B / 8B / small models for instant speed and massive rate limits.

# 1. Groq (Ultra-fast, high limits)
# Get free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=allam-2-7b

# 2. OpenRouter (Free tier 7B/8B models: Llama 3.1 8B, Mistral 7B, Gemini Flash Lite)
# Get free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# 3. Cloudflare Workers AI (10,000 requests/day 100% free)
# Get from Cloudflare Dashboard -> Workers & AI -> Overview
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# 4. NVIDIA NIM (Free inference credits for Llama 3.1 8B / Mistral 7B)
# Get free key: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# 5. Cerebras Cloud (Ultra-fast 2000 tokens/sec, free tier)
# Get free key: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# 6. Google Gemini (Lightweight 8B flash)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-8b

# 7. Custom / Local OpenAI-compatible endpoint (Ollama, vLLM, Orca, Together)
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=

# --- TTS ---
TTS_VOICE=en-US-ChristopherNeural
TTS_FALLBACK_VOICE=en-US-AriaNeural
AUDIO_OUTPUT_DIR=audio

# --- Scheduler ---
TIMEZONE=Asia/Kolkata
MORNING_REPORT_HOUR=6
MORNING_REPORT_MINUTE=30
EVENING_REPORT_HOUR=20
EVENING_REPORT_MINUTE=0
DEADLINE_ALERT_HOURS=24,2
DEADLINE_ALERT_CHECK_MINUTES=10

# --- Server ---
PORT=8000
LOG_LEVEL=INFO
LOG_FILE=logs/assistant.log

# --- Admin Alerts ---
SEND_ERROR_ALERTS=true

# --- Cognitive Vector Memory (Upstash Vector - 100% Free Forever) ---
# Create free index at https://console.upstash.com/ (Model: BAAI/bge-small-en-v1.5)
UPSTASH_VECTOR_REST_URL=https://your-index-name.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_rest_token_here
MEMORY_SIMILARITY_THRESHOLD=0.78
MEMORY_GATEKEEPER_THRESHOLD=7

